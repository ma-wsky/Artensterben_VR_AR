--- !u!114 &340350516
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 340350514}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Floreana-Riesenschildkr\xF6te (Chelonoidis niger)\r\n\u2022\tKurzfakt:
    Einst lebten gesch\xE4tzt 8.000 dieser Riesenschildkr\xF6ten auf der Gal\xE1pagos-Insel
    Floreana (Ecuador), bis sie um das Jahr 1850 in freier Wildbahn ausgerottet wurden.\r\n\u2022\tAussterbegrund:
    Zwischen dem 18. und fr\xFChen 19. Jahrhundert sammelten Walf\xE4nger und Seeleute
    die Tiere in massiven Mengen als lebenden Proviant und zur \xD6lgewinnung ab.
    Die Einf\xFChrung invasiver Arten wie Ratten, Schweine, Hunde, Katzen und Ziegen
    zerst\xF6rte zudem ihren Lebensraum.\r\n\u2022\tSDG-Bezug: Die Art ist als \"Ausgestorben\"
    (Extinct, EX) eingestuft, jedoch sind Hybride auf dem Vulkan Wolf entdeckt worden.
    Heute existiert ein ehrgeiziges Schutz- und Wiederansiedlungsprojekt (SDG-Ma\xDFnahme),
    das Nachkommen dieser Hybriden in das zu 98 % gesch\xFCtzte historische Verbreitungsgebiet
    zur\xFCckbringen soll. Sie ist im CITES-Anhang I (Handelsverbot) gelistet.\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
