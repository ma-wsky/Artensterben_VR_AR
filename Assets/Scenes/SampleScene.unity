  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Dodo (Raphus cucullatus): \r\nF\xFCr den Dodo (Raphus cucullatus) nennt
    die vorliegende Bewertung der IUCN Red List zwei prim\xE4re Gr\xFCnde f\xFCr
    das Aussterben der Art auf Mauritius:\r\n\r\nBejagung: Die V\xF6gel wurden von
    Siedlern und Seeleuten intensiv zur Nahrungsbeschaffung bejagt. Dies wurde durch
    die gro\xDFe Statur und die auff\xE4llige Zahmheit der flugunf\xE4higen Tiere
    stark beg\xFCnstigt.\r\n\r\nInvasive Arten: Ein weiterer Hauptgrund war die Pl\xFCnderung
    der Dodo-Nester durch eingef\xFChrte, nicht-heimische Tiere.\r\n\r\n\u2022\tDie
    letzten best\xE4tigten Sichtungen stammen aus dem Jahr 1662 von einer vorgelagerten
    Insel, wobei statistische Modelle ein endg\xFCltiges Aussterben um das Jahr 1690
    nahelegen\r\n\u2022\tDie Art war endemisch auf Mauritius und lebte dort vorwiegend
    in subtropischen/tropischen trockenen Tieflandw\xE4ldern sowie feuchten Bergw\xE4ldern\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
