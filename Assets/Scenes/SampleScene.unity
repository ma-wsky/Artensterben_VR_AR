  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Amur-Leopard (Panthera pardus orientalis)\r\n\u2022\tKurzfakt: Mit weltweit
    nur noch ca. 121 erwachsenen Tieren (Stand 2021) in einer kleinen Grenzregion
    zwischen Russland und China geh\xF6rt er zu den seltensten S\xE4ugetieren der
    Welt.\r\n\u2022\tGef\xE4hrdungsgrund: Massiver Lebensraumverlust durch Holzeinschlag,
    Waldbr\xE4nde und Landwirtschaft. Die Nahrungsgrundlage (Huftertiere) schwindet,
    hinzu kommen Wilderei (oft unabsichtlich in Fallen f\xFCr andere Tiere), Mensch-Wildtier-Konflikte
    und eine stark verarmte genetische Vielfalt.\r\n\u2022\tSDG-Bezug: Gilt laut
    Quelle als \"gef\xE4hrdet\" und ist durch CITES Anhang I vor kommerziellem Handel
    gesch\xFCtzt.  Es gibt erfolgreiche Schutzma\xDFnahmen: Durch die Gr\xFCndung
    des russischen \"Leopardovy Nationalparks\" im Jahr 2012 konnte sich der Bestand
    von ehemals nur etwa 35 Tieren (in 2007) wieder auf \xFCber 100 Tiere erholen.\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
