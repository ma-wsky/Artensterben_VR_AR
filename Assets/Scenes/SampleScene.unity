  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Beutelwolf (auch Tasmanischer Tiger, Thylacinus cynocephalus):\r\n\r\nGezielte
    Bejagung: Der Beutelwolf wurde als gro\xDFe Bedrohung f\xFCr Schafe angesehen.\r\nRegierungen
    und Privatpersonen setzten Pr\xE4mien auf die Tiere aus, weshalb sie intensiv
    gejagt, in Fallen gefangen und vergiftet wurden.\r\nEingef\xFChrte Arten und
    Konkurrenz: Auf dem australischen Festland verschwand die Art bereits vor Jahrtausenden,
    nachdem die indigene Bev\xF6lkerung Haushunde eingef\xFChrt hatte.\r\n Auch auf
    Tasmanien trug die zunehmende Konkurrenz durch Haushunde zum Aussterben bei\r\nWeitere
    Stressfaktoren: Lebensraumver\xE4nderungen und Krankheiten werden als zus\xE4tzliche
    Ursachen f\xFCr den Niedergang der Art genannt.\r\n\u2022\tDas letzte verifizierte
    wilde Exemplar wurde 1933 gefangen und starb 1936 im Hobart Zoo\r\n\u2022\tDie
    Art wurde in Tasmanien erst 1936 unter gesetzlichen Schutz gestellt \u2013 zu
    einem Zeitpunkt, als sie h\xF6chstwahrscheinlich bereits ausgestorben war.\r\nIm
    Jahr 1966 wurde in S\xFCdwest-Tasmanien ein 647.000 Hektar gro\xDFes Wildreservat
    eingerichtet, unter anderem in der Hoffnung, m\xF6glicherweise \xFCberlebende
    Exemplare zu sch\xFCtzen.\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
