--- !u!114 &1468283995
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1468283993}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Floreana-Riesenschildkr\xF6te (Chelonoidis niger, fr\xFCher oft als Unterart
    der Gal\xE1pagos-Riesenschildkr\xF6te genannt)\r\nDirekte Ausbeutung durch den
    Menschen: Die Schildkr\xF6ten wurden im 18. und fr\xFChen 19. Jahrhundert massiv
    von Walf\xE4ngern, Seeleuten und Siedlern gejagt, die sie als lebenden Proviant
    f\xFCr ihre Schiffe und zur \xD6lgewinnung absammelten.\r\nDie Best\xE4nde brachen
    daraufhin stark ein, und das endg\xFCltige Aussterben in freier Wildbahn auf
    der Insel Floreana wird auf die Zeit um 1850 gesch\xE4tzt\r\nInvasive Arten:
    Etwa um 1832 wurden zahlreiche fremde Tierarten auf der Insel eingef\xFChrt,
    darunter Schweine, Hunde, Katzen, Ziegen, Esel, Rinder sowie Hausratten und M\xE4use.
    Diese trugen massiv zur Zerst\xF6rung des Lebensraums (\xD6kosystemdegradation)
    sowie zur direkten Sterblichkeit der Schildkr\xF6ten bei.\r\n\u2022\tDie Art
    wird offiziell als Ausgestorben (Extinct, EX) gelistet, da heute keine genetisch
    reinen, lebenden Floreana Schildkr\xF6ten mehr nachgewiesen sind.\r\n\u2022\tDie
    Schildkr\xF6te war endemisch auf der Gal\xE1pagos-Insel Floreana (Ecuador) und
    bevorzugte subtropische bzw. tropische Trockenw\xE4lder und Buschland.\r\n\u2022\tAnders
    als bei vielen anderen ausgestorbenen Arten besteht hier noch Hoffnung. Wissenschaftler
    haben auf dem Vulkan Wolf (Insel Isabela) und in Gefangenschaft Hybride entdeckt,
    die teilweise die genetische Abstammung der Floreana-Schildkr\xF6te in sich tragen\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
