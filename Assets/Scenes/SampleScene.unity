  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Java Nashorn:\t\r\n\u2022\tStatus: Vom Aussterben bedroht (IUCN 2025).\r\n\u2022\tBestand:
    Nur noch ca. 50 Individuen weltweit.\r\n\u2022\tVerbreitung: Ausschlie\xDFlich
    im Nationalpark Ujung Kulon (Insel Java, Indonesien).\r\n\u2022\tGr\xF6\xDFe:
    150 \u2013 170 cm Schulterh\xF6he; Gewicht: 1.200 \u2013 1.500 kg.\r\n\u2022\tBesonderheit:
    Es ist die einzige Nashornart, bei der die Weibchen meist kein Horn besitzen.\r\nWarum
    sie aussterben.\r\n\u2022 Wilderei: Historisch die Hauptursache wegen der Nutzung
    der H\xF6rner in der asiatischen Medizin. Allein zwischen 2019 und 2023 fielen
    26 Tiere Wilderern zum Opfer.\r\n\u2022 Vulkangefahr: Die gesamte Weltpopulation
    lebt in der N\xE4he des aktiven Vulkans Anak Krakatau. Ein Ausbruch oder Tsunami
    k\xF6nnte die Art schlagartig ausl\xF6schen.\r\n\u2022 Invasive Arten: Die Zuckerpalme
    (Arenga obtusifolia) verdr\xE4ngt die Futterpflanzen der Nash\xF6rner.\r\n\u2022
    Platzmangel: Die Population hat die Kapazit\xE4tsgrenze ihres kleinen Schutzgebietes
    erreicht.\r\nSDG15: Das Java-Nashorn ist das ultimative Beispiel f\xFCr die Notwendigkeit,
    Wilderei zu stoppen und den Verlust biologischer Vielfalt durch winzige Restpopulationen
    zu verhindern.\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
