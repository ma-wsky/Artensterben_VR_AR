  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Dodo (Raphus cucullatus)\r\n\u2022\tKurzfakt: Der Dodo war ein flugunf\xE4higer,
    bodenlebender und zutraulicher Vogel, der ausschlie\xDFlich auf Mauritius vorkam\r\n\r\n\u2022\tAussterbegrund:
    Die Tiere wurden von Seeleuten und Siedlern intensiv als leichte Nahrungsquelle
    bejagt.\r\nZudem pl\xFCnderten von Menschen eingeschleppte Schweine die Nester. 
    Die letzte best\xE4tigte Sichtung gab es im Jahr 1662\r\n\r\n\u2022\tSDG-Bezug:
    Offiziell als \"Ausgestorben\" (Extinct, EX) in der IUCN Roten Liste gef\xFChrt.\r\nEs
    gab zum Zeitpunkt seines Aussterbens keinerlei Schutzgebiete, Kontrollen invasiver
    Arten oder Artenschutzma\xDFnahmen\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
